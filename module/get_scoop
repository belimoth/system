#!/bin/bash

set -o allexport
set -o errexit

get_scoop() {
	powershell -Command "Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Scope CurrentUser; Invoke-RestMethod -Uri https://get.scoop.sh | Invoke-Expression"
}

has scoop || get_scoop

alias scoop="env --unset GITHUB_TOKEN scoop"

scoop --version &> /dev/null || err "error: missing scoop"

function use_scoop_package {
	eval "function use_$1 { has $1 || scoop install $1; }"
}

function reg {
	eval "function get_$1 { scoop install ${2:-$1}; }"
	eval "function use_$1 { has $1 || get_$1; }"
}

reg 7zip
reg aws
reg cloc
reg gh
reg shellcheck
reg wget
reg ytdlp yt-dlp
reg zip
