#!/bin/bash

set -o allexport

function get_slug {
	slug=$1
	user=$( echo $slug | cut -d'/' -f1 )
	repo=$( echo $slug | cut -d'/' -f2 )
	[[ $slug == */* ]] || user=$GITHUB_USER
	slug="$user/$repo"
	echo "slug: $slug"
}

function code_drop {
	# code_drop <slug>

	local -; set -o errexit

	[[ -z $1 ]] && err

	slug=$1
	user=$( echo $slug | cut -d'/' -f1 )
	repo=$( echo $slug | cut -d'/' -f2 )
	[[ $slug == */* ]] || user=$GITHUB_USER
	slug="$user/$repo"
	echo "slug: $slug"

	cd ~/desktop/code

	[[ -d "$slug" ]] || err "error: folder '$slug' doesn't exist"

	cd $slug

	[[ -d ".git" ]] || err "error: folder $1 is not a git repo"

	echo "origin: $( git config --get remote.origin.url )"
	# [[ $( git config --get remote.origin.url ) == https://github.com/$user/* ]] || \
	# [[ $( git config --get remote.origin.url ) == git@github.com:$user/*     ]] || \
	# err "missing or incorrect origin"

	# TODO check all branches for unpushed changes

	[[ -f "null/uninstall" ]] && bash null/uninstall

	git ls-files -z | xargs -0 rm -f
	find . -name ".DS_Store" -delete
	find . -name "*.pyc"     -delete
	find . -type d -empty    -delete
	rm -rf ".git"

	cd ../..

	# test if project folder is empty and then remove it, otherwise rename appending date and index

	[[ -z "$(ls -A $slug)" ]] && rm -rf "$slug" || {
		dir=$1--$( date +%F )
		# guarantee that existing folders have sequential indexes
		i=0 && for f in $name--*; do [[ $f != "$name--$i" ]] && mv $f "$name--$i"; i=$( expr $i + 1 ); done
		mv "$1" "$name--$( ls -dq $name--* | wc -l | xargs )"
	}
}

function code_edit {
	# code_edit <slug>

	local -; set -o errexit

	[[ -z $1 ]] && err

	slug=$1
	org=$(  echo $slug | cut -d'/' -f1 )
	repo=$( echo $slug | cut -d'/' -f2 )
	[[ $slug == */* ]] || org=$GITHUB_USER
	slug=$org/$repo

	[[ -d ~/desktop/code/$slug ]] || err $slug

	cd ~/desktop/code/$slug
	[[ -f ./user/init ]] && ./user/init
	code . --reuse-window
}

function code_list {
	local -; set -o errexit

	name="${1:-$GITHUB_USER}"

	[[ -d ~/desktop/code/$name ]] || err

	[[ $* == *--all* ]] && {
		pass
	}

	# ls -1 --almost-all ~/desktop/code/$name

	# cd ~/desktop/code/$name
	# find . -mindepth 1 -maxdepth 1 -type d | sed "s|\./|$name/|g"

	cd ~/desktop/code
	find . -mindepth 2 -maxdepth 2 -type d | sed "s|\./||g"
}

function code_list_all {
	local -; set -o errexit
	name="${1:-$GITHUB_USER}"
	code_list $name
	# todo
}

function code_pull {
	# code_pull <slug> && code_edit $_
	local -; set -o errexit

	[[ -z $1 ]] && err

	slug=$1
	name=$( echo $slug | cut -d'/' -f1 )
	repo=$( echo $slug | cut -d'/' -f2 )
	[[ $slug == */* ]] || name=$GITHUB_USER
	slug=$name/$repo

	cd ~/desktop/code

	mkdir --parents $name && cd $_

	git clone $( ~/desktop/user/hub/hub_url $slug )

	cd $repo

	# [[ -f ./user/profile/$USER/pull ]] && bash ./user/profile # todo check functions for remote instead
}

function code_push_new {
	local -; set -o errexit

	[[ -z $1 ]] && err

	slug=$1
	name=$( echo $slug | cut -d'/' -f1 )
	repo=$( echo $slug | cut -d'/' -f2 )
	[[ $slug == */* ]] || name=$GITHUB_USER
	slug=$name/$repo

	#

	[[ -d ~/desktop/code/$slug ]] && err

	mkdir --parents ~/desktop/code/$slug && cd $_

	git init

	#

	git commit --allow-empty --allow-empty-message --message ""
	touch .gitignore
	git add .gitignore
	git commit --allow-empty-message --message ""

	# TODO handle case where repo already exists

	hub_new $slug

	git remote add                  origin $( hub_url $slug )
	git remote set-url --add --push origin $( hub_url $slug )

	git push --set-upstream origin main
}
