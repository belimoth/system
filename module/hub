#!/bin/bash

set -o allexport

alias gh="GH_TOKEN=$GITHUB_TOKEN gh"

has gh || {
	use get_scoop
	scoop install gh

	set +o errexit

	copilot -i uninstall
	gh copilot --remove
	npm uninstall -g @github/copilot
	winget uninstall GitHub.Copilot

	gh extension remove github/gh-copilot
	gh config set telemetry disabled
}

function hub_new {
	return 1
}

function hub_url {
	echo git@github.com:${1}.git
}
