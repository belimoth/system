#!/bin/bash

set -o allexport

has python || get_python

[[ -x $( command -v python )                                        ]] || err "python not installed"
[[ $( command -v python ) == *"WindowsApps"*                        ]] && err "app execution alias detected"
[[ $( python -c "import sys; print( sys.version_info[0] )" ) == "3" ]] || err "python 3 not installed"

function use_python_package {
	[[ -z $1 ]] && err
	python -c "import $1" > /dev/null 2>&1 || err "package $1 not installed, run 'pip install $1'"
}

[[ $( pwd ) == "/a" ]] || return 0

function activate {
	[[ -d "/a/null/venv" ]] || err "error: venv not initialized; run 'install'"

	# shellcheck disable=SC1091
	source /a/null/venv/scripts/activate
	export PYTHONPYCACHEPREFIX=/a/null/run
}

[[ -f /a/user/python/runtime.txt ]] && [[ $( python --version ) == $( cat /a/user/python/runtime.txt ) ]] || echo "warning: python version mismatch"
