#!/bin/bash

set -o allexport

alias md="mkdir --parents"
alias pass=":"

PATH=$PATH:~/desktop/user
PATH=$PATH:~/desktop/user/profile/$USER

function err {
	echo error: $@
	return 1
}

function has {
	command -v $1 &> /dev/null || err
}

function use {
	set -o allexport

	function stub { eval "function use_$1 { pass; }"; }

	[[ -d ~/desktop/user/package/$1 ]] && PATH=$PATH:~/desktop/user/package/$1

	[[ $( type -t use_$1 ) == function ]] && {
		eval "use_$1"
		stub $1
		return 0
	}

	[[ -f ~/desktop/user/module/$1 ]] && {
		set -o allexport
		source ~/desktop/user/module/$1
		stub $1
		return 0
	}

	err use $1
}

use os
