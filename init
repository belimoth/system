#!/bin/bash

set -o allexport

alias set="local -; set"
alias md="mkdir --parents"
alias pass=":"

function err {
	echo error: $@
	return 1
}

function has {
	command -v $1 &> /dev/null || err
}

function use {
	function stub { eval "function use_$1 { pass; }"; }
	function stub { pass; }
	[[ $( type -t use_$1 ) == function ]] && { eval "use_$1"; stub $1; return 0; }
	[[ -f ~/desktop/user/module/$1 ]] && { source ~/desktop/user/module/$1; stub $1; return 0; }
	err use $1
}
