#!/bin/bash

has python || get_python
[[ $( command -v python ) == *"WindowsApps"* ]] && { echo "error: app execution alias detected"; return 1; }
[[ $( python -c "import sys; print( sys.version_info[0] )" ) == "3" ]] || { echo "error: python 3 not installed"; return 1; }

def use_python_package {
	[[ -z $1 ]] && { echo error; return 1; }
	python -c "import $1" > /dev/null 2>&1 || { echo "error: package $1 not installed, run 'pip install $1'"; return 1; }
}
