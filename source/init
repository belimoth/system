#!/bin/bash

set -o allexport

alias set="local -; set"
alias def=function
alias md=mkdir
alias pass=":"
alias void="/dev/null 2>&1"

def use_os {
	[[ $( uname --operating-system ) == "Msys" ]] || { echo "error: unsupported os"; return 1; }
}

def use_python_package {
	[[ -z $1 ]] && { echo error; return 1; }
	python -c "import $1" > /dev/null 2>&1 || { echo "error: package $1 not installed, run 'pip install $1'"; return 1; }
}

def has {
	[[ -z $1 ]] || return 1
	[[ -x $( command -v $1 ) ]] || return 1
}

def use {
	[[ $( type -t use_$1 ) == function  ]] && {               use_$1; eval "def use_$1 { pass; }"; return 0; }
	[[ -x $( command -v source/use_$1 ) ]] && { source source/use_$1; eval "def use_$1 { pass; }"; return 0; }
	echo error
	return 1
}

def view {
	pass
}
