def use_python_package {
	[[ -z $1 ]] && { echo error; return 1; }
	python -c "import $1" > /dev/null 2>&1 || { echo "error: package $1 not installed, run 'pip install $1'"; return 1; }
}

def use_scoop {
	[[ -x scoop ]] || powershell -Command "Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Scope CurrentUser; Invoke-RestMethod -Uri https://get.scoop.sh | Invoke-Expression"

	alias scoop="env --unset GITHUB_TOKEN scoop"

	scoop --version || {
		echo "error: missing scoop"
		exit 1
	}
}

def use_ssh {
    set -o allexport

    def agent_start {
        status=$( ssh-add -l > /dev/null 2>&1; echo $? )
        [[ $status == 2 ]] && eval $( ssh-agent )

        status=$( ssh-add -l > /dev/null 2>&1; echo $? )
        [[ $status == 1 ]] && ssh-add
    }

    def agent_list {
        ssh-add -l
    }

    def agent_clear {
        ssh-add -D
    }

    def agent_kill {
        eval $( ssh-agent -k )
    }

    def ssh_test {
        echo ok
    }
}

