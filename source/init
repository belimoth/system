#!/bin/bash

set -o allexport

use_os() {
    [[ $( uname --operating-system ) == "Msys" ]] || {
        echo "error: unsupported os"
        exit 1
    }
}

use_bash() {
    set -o allexport

    PS1="\w> "
    # PS1="\u@\h \w> "

    HISTCONTROL=erasedups
    HISTSIZE=10000
    shopt -s histappend

    PROMPT_COMMAND="history -a"
}

use_git() {
    PATH=$PATH:~/desktop/user/git
    export PAGER=
}

use_hub() {
    set -o allexport

    agent_start() {
        status=$( ssh-add -l > /dev/null 2>&1; echo $? )
        [[ $status == 2 ]] && eval $( ssh-agent )

        status=$( ssh-add -l > /dev/null 2>&1; echo $? )
        [[ $status == 1 ]] && ssh-add
    }

    agent_list() {
        ssh-add -l
    }

    agent_clear() {
        ssh-add -D
    }

    agent_kill() {
        eval $( ssh-agent -k )
    }

    ssh_test() {
        echo ok
    }
}

use_python() {
    [[ $( command -v python ) == *"WindowsApps"* ]] && { echo "error: app execution alias detected" exit 1; }
    [[ -x $( command -v python ) ]] || { echo "error: python not installed"; exit 1; }
    [[ $( python -c "import sys; print( sys.version_info[0] )" ) == "3" ]] || { echo "error: python 3 not installed"; exit 1; }
}

use_python_package() {
    [[ -z $1 ]] && {
        echo "error"
        exit 1
    }

    python -c "import $1" > /dev/null 2>&1 || {
        echo "error: package $1 not installed, run 'pip install $1'"
        exit 1
    }
}

use_scoop() {
    [[ -x scoop ]] || powershell -Command "Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Scope CurrentUser; Invoke-RestMethod -Uri https://get.scoop.sh | Invoke-Expression"

    alias scoop="env --unset GITHUB_TOKEN scoop"

    scoop --version || {
        echo "error: missing scoop"
        exit 1
    }
}

use_windows() {
    set -o allexport

    windows_env() {
        rundll32.exe sysdm.cpl,EditEnvironmentVariables
    }

    windows_credential_manager() {
        control -name Microsoft.CredentialManager
    }
}

use() {
    [[ $( type -t use_$1 ) == function ]] || { echo error; return 1; }
    [[ $( type -t use_$1 ) == function ]] && use_$1
}

#

install_github() {
    scoop install gh

    copilot -i uninstall
    gh copilot --remove
    npm uninstall -g @github/copilot
    winget uninstall GitHub.Copilot

    gh extension remove github/gh-copilot
    gh config set telemetry disabled
}

#

edit() {
	[[ -z $1 ]] && {
		cd ~/desktop/code/$USER
		code . --reuse-window
		exit
	}

	[[ $1 == "user" ]] && {
		cd ~/desktop/user
		code . --reuse-window
		exit
	}

	code-edit $@
}

pull() {
	code_pull $@
}

use git

save() {
	git_commit_empty
}

sync() {
    git_sync
}
