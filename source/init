#!/bin/bash

set -o allexport

alias set="local -; set"
alias def=function
alias md=mkdir
alias pass=":"

def use_os {
	[[ $( uname --operating-system ) == "Msys" ]] || { echo "error: unsupported os"; return 1; }
}

def use_git {
	source ~/desktop/user/source/git
	# PATH=$PATH:~/desktop/user/git
	export PAGER=
}

def use_google_once {
	set -o xtrace

	reg add "HKLM\Software\Policies\Microsoft\Edge" -v DefaultSearchProviderEnabled   -t REG_DWORD -d 1                                        -f
	reg add "HKLM\Software\Policies\Microsoft\Edge" -v DefaultSearchProviderName      -t REG_SZ    -d "Google"                                 -f
	reg add "HKLM\Software\Policies\Microsoft\Edge" -v DefaultSearchProviderSearchURL -t REG_SZ    -d "https://google.com{searchTerms}&udm=14" -f
}

def use_hub {
	[[ -z $( command -v gh ) ]] && {
		use scoop
		scoop install gh

		copilot -i uninstall
        gh copilot --remove
        npm uninstall -g @github/copilot
        winget uninstall GitHub.Copilot

        gh extension remove github/gh-copilot
        gh config set telemetry disabled
	}

	def hub_new {
		use os
		use python
		use python_package requests
		return 1

		[[ -z $GITHUB_USER ]] && { echo "error: missing GITHUB_USER environment variable"; exit 1; }

		token_path=~/desktop/null/key/token-gh

		[[ -f $token_path ]] || { echo "error: missing token file"; exit 1; }

		# shellcheck disable=SC2155
		export GITHUB_TOKEN=$( cat $token_path )

		python ~/desktop/user/source/forge_create_repo_gh.py $1
	}

	def hub_url {
		echo git@github.com:${1}.git
	}
}

