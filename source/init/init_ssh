#!/bin/bash

agent_start() {
	status=$( ssh-add -l > /dev/null 2>&1; echo $? )
	[[ $status == 2 ]] && eval $( ssh-agent )

	status=$( ssh-add -l > /dev/null 2>&1; echo $? )
	[[ $status == 1 ]] && ssh-add
}

agent_list() {
	ssh-add -l
}

agent_clear() {
	ssh-add -D
}

agent_kill() {
	eval $( ssh-agent -k )
}

ssh_test() {
	echo ok
}
