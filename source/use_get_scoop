#!/bin/bash

get_scoop() {
	powershell -Command "Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Scope CurrentUser; Invoke-RestMethod -Uri https://get.scoop.sh | Invoke-Expression"
}

has scoop || get_scoop

alias scoop="env --unset GITHUB_TOKEN scoop"

scoop --version &> /dev/null || {
	echo "error: missing scoop"
	exit 1
}

def use_scoop_package {
	set -o allexport
	eval "def use_$1 { has $1 || scoop install $1; }"
}

def reg {
	eval "def get_$1 { scoop install ${2:-$1}; }"
	eval "def use_$1 { has $1 || get_$1; }"
}

reg 7zip
reg aws
reg cloc
reg gh
reg shellcheck
reg wget
reg ytdlp yt-dlp
reg zip
