#!/bin/bash

[[ -x scoop ]] || powershell -Command "Set-ExecutionPolicy -ExecutionPolicy RemoteSigned -Scope CurrentUser; Invoke-RestMethod -Uri https://get.scoop.sh | Invoke-Expression"

alias scoop="env --unset GITHUB_TOKEN scoop"

scoop --version || {
	echo "error: missing scoop"
	exit 1
}

def use_scoop_package {
	set -o allexport
	eval "def use_$1 { has $1 || scoop install $1; }"
}

def get_7zip       { scoop install 7zip; }
def get_aws        { scoop install aws; }
def get_cloc       { scoop install cloc; }
def get_gh         { scoop install gh; }
def get_shellcheck { scoop install shellcheck; }
def get_wget       { scoop install wget; }
def get_ytdlp      { scoop install yt-dlp; }
def get_zip        { scoop install zip; }
