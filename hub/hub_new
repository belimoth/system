#!/bin/bash

set -o errexit

source ~/desktop/user/source/common.sh

assert_os
assert_pythonw
assert_python_package requests

[[ -z $GITHUB_USER ]] && { echo "error: missing GITHUB_USER environment variable"; exit 1; }

token_path=~/desktop/null/key/token-gh

[[ -f $token_path ]] || { echo "error: missing token file"; exit 1; }

# shellcheck disable=SC2155
export GITHUB_TOKEN=$( cat $token_path )

python ~/desktop/user/source/forge_create_repo_gh.py $1
