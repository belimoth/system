#!/bin/bash

help_bash() {
	bash --help
}

help_bash_shell() {
	bash -c "help set"
}

help_bash_builtins() {
	bash -c "help"
}

help_git() {
	git help
}

help_git_commands() {
	git help --all
}

help_git_concepts() {
	git help --guides
}

help_user() {
	echo code_drop <slug>
	echo code_edit <slug>
	echo code_list
	echo code_list_all
	echo code_pull <slug>
	echo code_push <slug>
}
