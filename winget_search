#/bin/bash

winget search --query "" > ~/desktop/null/winget_index

function yank {
	grep --perl-regexp "$2" ~/desktop/null/winget_index                > ~/desktop/null/winget_index_$1
	grep --perl-regexp "$2" ~/desktop/null/winget_index --invert-match > ~/desktop/null/winget_index_temp
	mv ~/desktop/null/winget_index_temp ~/desktop/null/winget_index
}

