#!/bin/bash

# usage:
# code-clone <slug> && code-edit $_

set -o errexit

[[ -z $1 ]] && { echo error; exit 1; }

slug=$1
name=$( echo $slug | cut -d'/' -f1 )
repo=$( echo $slug | cut -d'/' -f2 )
[[ $slug == */* ]] || name=$GITHUB_USER
slug=$name/$repo

cd ~/desktop/code

mkdir --parents $name && cd $_

git clone $( ~/desktop/user/forge/forge_url_gh $slug )

cd $repo

[[ -f ./user/profile/$USER/pull ]] && bash ./user/profile
