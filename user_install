#!/bin/bash

set -o errexit

alias md=mkdir

[[ -d ~/desktop ]] || md ~/desktop

cd ~/desktop

[[ -d ~/desktop/user ]] || md ~/desktop/user

[[ -d ~/desktop/user/.git ]] || git clone git@github.com:subhelion/user.git

[[ -d ~/desktop/code ]] || md ~/desktop/code
[[ -d ~/desktop/data ]] || md ~/desktop/data
[[ -d ~/desktop/file ]] || md ~/desktop/file
[[ -d ~/desktop/null ]] || md ~/desktop/null
