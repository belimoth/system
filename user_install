#!/bin/bash

set -o errexit

[[ -d ~/desktop ]] || mkdir ~/desktop

cd ~/desktop

[[ -d ~/desktop/user ]] || mkdir ~/desktop/user

[[ -d ~/desktop/user/.git ]] || git clone git@github.com:belimoth/user.git

[[ -d ~/desktop/code ]] || mkdir ~/desktop/code
[[ -d ~/desktop/data ]] || mkdir ~/desktop/data
[[ -d ~/desktop/file ]] || mkdir ~/desktop/file
[[ -d ~/desktop/null ]] || mkdir ~/desktop/null
