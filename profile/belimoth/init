set -o allexport

MSYS=winsymlinks:nativestrict

alias def=function

USER=belimoth
GITHUB_USER=belimoth
GITHUB_TOKEN=$( cat ~/desktop/null/key/token-gh )

PATH=$PATH:~/desktop/user
PATH=$PATH:~/desktop/user/profile/$USER

source ~/desktop/user/source/init

def user_init {
	source ~/desktop/user/source/init
	source ~/desktop/user/profile/$USER/init
}

def user_install {
    use os
    use scoop

	scoop install aws
	scoop install 7zip
	scoop install cloc
	scoop install gh
	scoop install shellcheck
	scoop install wget
	scoop install yt-dlp
	scoop install zip
}

def user_link {
	set -o errexit
	set -o xtrace

	ln --force ~/desktop/user/profile/belimoth/home/.bash_profile ~/.bash_profile
	ln --force ~/desktop/user/profile/belimoth/home/.bashrc       ~/.bashrc
	ln --force ~/desktop/user/profile/belimoth/home/.inputrc      ~/.inputrc
	ln --force ~/desktop/user/profile/belimoth/home/.gitconfig    ~/.gitconfig

	ln --force ~/desktop/user/profile/belimoth/vscode/keybindings.json ~/appdata/roaming/code/user/keybindings.json
	ln --force ~/desktop/user/profile/belimoth/vscode/settings.json    ~/appdata/roaming/code/user/settings.json
}

alias ls="ls -1"
alias gh="GH_TOKEN=$GITHUB_TOKEN gh"

