use code
use data

def edit {
	[[ -z $1 ]] && {
		cd ~/desktop/code/$USER
		code . --reuse-window
		exit
	}

	[[ $1 == "user" ]] && {
		cd ~/desktop/user
		code . --reuse-window
		exit
	}

	code_edit $@
}

def pull {
	code_pull $@
}

