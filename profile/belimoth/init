#

pull() {
	slug=$1
	name=$( echo $slug | cut -d'/' -f1 )
	repo=$( echo $slug | cut -d'/' -f2 )
	[[ $slug == */* ]] || name=$GITHUB_USER
	slug=$name/$repo

	code_pull $@

	cd ~/desktop/code/$slug

	git ls-remote https://github.com/belimoth/$repo  > /dev/null 2>&1 && \
	git ls-remote https://github.com/subhelion/$repo > /dev/null 2>&1 && {
		git remote rm                   origin
		git remote add                  origin git@github.com:subhelion/$repo.git
		git remote set-url --add --push origin git@github.com:subhelion/$repo.git
		git remote set-url --add --push origin git@github.com:belimoth/$repo.git
	}
}
