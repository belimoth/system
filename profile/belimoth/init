set -o allexport

MSYS=winsymlinks:nativestrict

USER=belimoth
GITHUB_USER=belimoth
GITHUB_TOKEN=$( cat ~/desktop/null/key/token-gh )

PATH=$PATH:~/desktop/user
PATH=$PATH:~/desktop/user/profile/$USER

source init

def user_init {
	source ~/desktop/user/profile/$USER/init
}

def user_install {
	use os

	use get_scoop
	use get_winget

	use 7zip
	use aws
	use cloc
	use git
	use hub
	use shellcheck
	use wget
	use windows
	use ytdlp
}

alias ls="ls -1"
alias gh="GH_TOKEN=$GITHUB_TOKEN gh"

def user_status {
	# todo

	echo user status aws ; aws  --version; echo
	echo user status bash; bash --version; echo
	echo user status git ; git  --version; echo1

	echo user status python; python --version; echo
	echo user status python; pip freeze; echo
	echo user status scoop ; scoop --version; echo
	echo user status scoop ; scoop status; echo
}

def user_update {
	butler upgrade --assume-yes
	python -m pip install --upgrade pip
	scoop update
	scoop update "*"
}

def user_check_script {
	use shellcheck
	cd ~/desktop/user
	shopt -s globstar
	shellcheck --shell=bash --exclude=SC1090,SC2046,SC2086, -- *
}

def user_edit_script {
	[[ -x $( command -v $1 ) ]] || { echo "error"; exit 1;}
	code $( which $1 )
}

def key_list_all {
	cmdkey -list
}

def key_manage {
	rundll32.exe keymgr.dll,KRShowKeyMgr
}

def key_pull {
	use os
	use python
	use_python_package keyring
}

def key_push {
	echo
}

use code
use data

def edit {
	[[ -z $1 ]] && {
		cd ~/desktop/code/$USER
		code . --reuse-window
		exit
	}

	[[ $1 == "user" ]] && {
		cd ~/desktop/user
		code . --reuse-window
		exit
	}

	code_edit $@
}

def pull {
	code_pull $@
}

