def fast_init_load {
	[[ -f ~/desktop/null/user/init ]] || return 1
	set -o allexport
	source ~/desktop/null/user/init
	set +o allexport
	echo fast
	return 0
}

fast_init_load && return 0

def fast_init_save {
	md --parents ~/desktop/null/user
	[[ -f ~/desktop/null/user/init ]] && rm ~/desktop/null/user/init
	touch ~/desktop/null/user/init
	shopt -op >> ~/desktop/null/user/init
	# env >> ~/desktop/null/user/init
	export -p | grep -Ev '^(declare -xr|export) (BASH|_=|PWD|OLDPWD|SHELLOPTS|SHLVL|UID|PPID)' >> ~/desktop/null/user/init
	# declare -p | grep -Ev '^(declare -xr|export) (BASH|_=|PWD|OLDPWD|SHELLOPTS|SHLVL|UID|PPID)' >> ~/desktop/null/user/init
	declare -f | grep -Ev '^(declare -xr|export) (BASH|_=|PWD|OLDPWD|SHELLOPTS|SHLVL|UID|PPID)' >> ~/desktop/null/user/init
}

def fast_init_thaw {
	rm ~/desktop/null/user/init
}
